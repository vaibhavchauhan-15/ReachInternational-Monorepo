{
  "name": "reachinternational-monorepo",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "build:worker": "pnpm --filter @reachinternational/web build:worker",
    "dev:worker": "pnpm --filter @reachinternational/web dev:worker",
    "preview:worker": "pnpm --filter @reachinternational/web preview:worker",
    "deploy:worker": "pnpm --filter @reachinternational/web deploy:worker",
    "cf-typegen": "pnpm --filter @reachinternational/web cf-typegen",
    "wrangler": "pnpm --filter @reachinternational/web exec wrangler",
    "build:mobile": "pnpm --filter @reachinternational/mobile exec eas build --platform android --profile production",
    "build:mobile:apk": "pnpm --filter @reachinternational/mobile exec eas build --platform android --profile production-apk",
    "build:mobile:preview": "pnpm --filter @reachinternational/mobile exec eas build --platform android --profile preview",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "check:type": "node scripts/check-typography.mjs",
    "test": "node scripts/run-all-tests.mjs",
    "test:all": "node scripts/run-all-tests.mjs && turbo run typecheck",
    "seed": "node supabase/seed.mjs",
    "verify:seed": "node supabase/verify_seed.mjs",
    "agentation:mcp": "npx -y agentation-mcp server",
    "postinstall": "node scripts/patch-opennext.js"
  },
  "devDependencies": {
    "@supabase/supabase-js": "^2.117.3",
    "@types/node": "^20.19.43",
    "sharp": "^0.35.5",
    "turbo": "^2.11.7"
  },
  "overrides": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "image-size": ">=2.0.3",
    "postcss": ">=8.5.23",
    "uuid": ">=11.1.1",
    "@xmldom/xmldom": ">=0.9.12",
    "@babel/generator": "^7.29.8"
  },
  "packageManager": "pnpm@11.21.0"
}
