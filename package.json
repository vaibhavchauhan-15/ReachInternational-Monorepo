{
  "name": "reachinternational-monorepo",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "build:mobile": "pnpm --filter @reachinternational/mobile exec eas build --platform android --profile production",
    "build:mobile:preview": "pnpm --filter @reachinternational/mobile exec eas build --platform android --profile preview",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "verify:seed": "node supabase/verify_seed.mjs"
  },
  "devDependencies": {
    "@supabase/supabase-js": "^2.112.4",
    "@types/node": "^20.19.43",
    "turbo": "^2.10.11"
  },
  "overrides": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "image-size": ">=2.0.3",
    "postcss": ">=8.5.23",
    "uuid": ">=11.1.1"
  },
  "packageManager": "pnpm@11.21.0"
}
