# ==============================================================================
# ReachInternational Monorepo — Environment Variable Template
# ==============================================================================
# This template defines all environment-dependent configuration across the monorepo.
#
# LOCAL DEVELOPMENT:
# - Web: Copy relevant variables to `apps/web/.env.local`
# - Mobile: Copy relevant variables to `apps/mobile/.env` or `apps/mobile/.env.local`
#
# DEPLOYMENT PLATFORMS:
# - Web (Vercel): Set in Vercel Project Settings -> Environment Variables
# - Mobile (EAS Build): Set public variables in `apps/mobile/eas.json` or EAS Secrets
# - CI/CD (GitHub Actions): Set in Repository Settings -> Secrets and Variables
#
# IMPORTANT SECURITY POLICIES:
# 1. Variables with `NEXT_PUBLIC_` are bundled into the web browser client JavaScript.
# 2. Variables with `EXPO_PUBLIC_` are bundled into the mobile client application binary.
# 3. Server secrets (SUPABASE_SECRET_KEY, INTERNAL_AUTH_SECRET, CRON_SECRET, etc.)
#    MUST NEVER have a public prefix and MUST NEVER be exposed to client-side code.
# ==============================================================================

# ==============================================================================
# 1. WEB APPLICATION — PUBLIC CONFIGURATION (apps/web)
# ==============================================================================
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key_here
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-DC126P3SM9
NEXT_PUBLIC_APP_VERSION=1.0.0
NEXT_PUBLIC_SENTRY_DSN=https://your_sentry_dsn_here@o0.ingest.sentry.io/0

# Web Feature Flags
NEXT_PUBLIC_ENABLE_AGENTATION=false
NEXT_PUBLIC_ENABLE_PULL_TO_REFRESH=true

# ==============================================================================
# 2. NATIVE MOBILE APP — PUBLIC CONFIGURATION (apps/mobile)
# Safe for mobile bundle (read-only client endpoints, protected by Supabase RLS)
# ==============================================================================
EXPO_PUBLIC_APP_ENV=development
EXPO_PUBLIC_SHELL_MODE=native
EXPO_PUBLIC_SCHEME=reachinternational
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_publishable_key_here
EXPO_PUBLIC_APP_URL=https://dashboard-reachinternational.vercel.app
EXPO_PUBLIC_WEB_APP_URL=https://dashboard-reachinternational.vercel.app
EXPO_PUBLIC_SENTRY_DSN=https://your_sentry_dsn_here@o0.ingest.sentry.io/0
EXPO_PUBLIC_ENABLE_AGENTATION=false

# ==============================================================================
# 3. SERVER-ONLY SECRETS (STRICTLY SERVER RUNTIMES ONLY)
# NEVER import or bundle these in React client components or Expo mobile builds!
# ==============================================================================
# Supabase Service Role Key (bypasses RLS — server-only DAL/Admin actions)
SUPABASE_SECRET_KEY=your_supabase_service_role_secret_key_here

# Internal Auth HMAC Signing Secret (Edge proxy <-> Server communication)
INTERNAL_AUTH_SECRET=your_32_byte_hex_internal_auth_secret_here

# Cron / Automation Security Token
CRON_SECRET=your_random_cron_secret_here

# Optional: Upstash Redis (Distributed Rate Limiting)
UPSTASH_REDIS_REST_URL=https://your-upstash-redis.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_upstash_redis_token_here

# Optional: Server-Side Sentry DSN
SENTRY_DSN=https://your_sentry_dsn_here@o0.ingest.sentry.io/0

# Optional: Communications & Notifications (Twilio / SendGrid / QStash)
TWILIO_ACCOUNT_SID=your_twilio_account_sid_here
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here
TWILIO_WHATSAPP_NUMBER=whatsapp:+10000000000
TWILIO_SMS_NUMBER=+10000000000
TWILIO_CONTENT_SID=your_twilio_content_sid_here
SENDGRID_API_KEY=SG.your_sendgrid_api_key_here
SENDGRID_FROM_EMAIL=notifications@yourdomain.com
SENDGRID_FROM_NAME=ReachInternational
QSTASH_TOKEN=your_upstash_qstash_token_here
