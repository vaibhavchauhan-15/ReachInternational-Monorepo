# ReachInternational Monorepo — Environment Variable Template
# Copy to `.env.local` or configure in deployment platform secrets (Vercel, Supabase, EAS)

# ==============================================================================
# 1. PUBLIC / PUBLISHABLE KEYS (SAFE FOR BROWSER & MOBILE APP)
# ==============================================================================
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key_here
NEXT_PUBLIC_APP_URL=http://localhost:3000

EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_your_key_here
EXPO_PUBLIC_APP_ENV=development
EXPO_PUBLIC_SCHEME=reachservice

# ==============================================================================
# 2. SERVER-ONLY SECRETS (STRICTLY RESTRICTED TO BACKEND / SERVER RUNTIMES)
# NEVER EXPOSE TO REACT CLIENT COMPONENTS OR EXPO MOBILE BUNDLES!
# ==============================================================================
SUPABASE_SECRET_KEY=your_supabase_service_role_secret_key_here

# Twilio SMS & WhatsApp API Credentials
TWILIO_ACCOUNT_SID=your_twilio_account_sid_here
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here
TWILIO_WHATSAPP_NUMBER=whatsapp:+10000000000
TWILIO_SMS_NUMBER=+10000000000
TWILIO_CONTENT_SID=your_twilio_content_sid_here

# SendGrid Email API Credentials
SENDGRID_API_KEY=SG.your_sendgrid_api_key_here
SENDGRID_FROM_EMAIL=notifications@yourdomain.com
SENDGRID_FROM_NAME=ReachInternational

# Optional Queue / Background Worker Secrets
CRON_SECRET=your_random_cron_secret_here
QSTASH_TOKEN=your_upstash_qstash_token_here
