{
  "name": "@reachinternational/mobile",
  "version": "1.4.0",
  "private": true,
  "main": "index.js",
  "scripts": {
    "start": "expo start",
    "start:go": "expo start --go",
    "start:clean": "expo start -c",
    "clean:cache": "node -e \"const os=require('os'),fs=require('fs'),path=require('path');const t=os.tmpdir();fs.readdirSync(t).filter(f=>f.startsWith('metro-file-map')||f.startsWith('haste-map')).forEach(f=>{try{fs.unlinkSync(path.join(t,f))}catch{}});console.log('Metro cache cleared.');\"",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "test": "node test/run-tests.mjs",
    "test:all": "node test/index.mjs",
    "test:splash": "node test/test-splash-screen.mjs",
    "test:settings": "node test/test-settings-workflows.mjs",
    "test:navigation": "node test/test-navigation-transitions.mjs",
    "test:assign-modal": "node test/test-assign-operator-modal.mjs",
    "test:assignments": "node test/test-standardized-assignment-ui.mjs",
    "test:press-feedback": "node test/test-press-feedback.mjs",
    "test:whats-new": "node test/test-whats-new-system.mjs",
    "test:running-logs": "node test/test-running-logs-workflows.mjs",
    "test:auth": "node test/test-auth-workflows.mjs",
    "test:machines": "node test/test-machines-workflows.mjs",
    "test:shifts": "node test/test-shift-workflows.mjs",
    "test:users": "node test/test-users-workflows.mjs",
    "test:documents": "node test/test-document-viewer-workflows.mjs",
    "test:clients": "node test/test-client-details-workflows.mjs",
    "build": "echo \"Mobile app build target ready\""
  },
  "dependencies": {
    "@kishannareshpal/expo-pdf": "^0.3.2",
    "@reachinternational/design-tokens": "workspace:*",
    "@reachinternational/permissions": "workspace:*",
    "@reachinternational/types": "workspace:*",
    "@reachinternational/utils": "workspace:*",
    "@reachinternational/validation": "workspace:*",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/netinfo": "12.0.1",
    "@rn-primitives/alert-dialog": "^1.5.2",
    "@rn-primitives/avatar": "^1.5.2",
    "@rn-primitives/checkbox": "^1.5.2",
    "@rn-primitives/dialog": "^1.5.2",
    "@rn-primitives/popover": "^1.5.2",
    "@rn-primitives/portal": "~1.4.0",
    "@rn-primitives/progress": "^1.5.2",
    "@rn-primitives/radio-group": "^1.5.2",
    "@rn-primitives/separator": "^1.5.2",
    "@rn-primitives/slot": "^1.5.2",
    "@rn-primitives/tabs": "^1.5.2",
    "@rn-primitives/tooltip": "^1.5.2",
    "@rn-primitives/types": "^1.5.2",
    "@sentry/react-native": "~8.33.0",
    "@supabase/supabase-js": "^2.117.3",
    "@tanstack/query-async-storage-persister": "^5.104.1",
    "@tanstack/react-query": "^5.66.0",
    "@tanstack/react-query-persist-client": "^5.104.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "expo": "~58.0.22",
    "expo-clipboard": "~58.0.4",
    "expo-constants": "~58.0.13",
    "expo-document-picker": "~58.0.4",
    "expo-file-system": "~58.0.11",
    "expo-font": "~58.0.10",
    "expo-haptics": "~58.0.7",
    "expo-linear-gradient": "~58.0.3",
    "expo-linking": "~58.0.14",
    "expo-print": "~58.0.7",
    "expo-router": "~58.0.26",
    "expo-secure-store": "~58.0.2",
    "expo-sharing": "~58.0.20",
    "expo-splash-screen": "~58.0.11",
    "expo-status-bar": "~58.0.4",
    "expo-system-ui": "~58.0.6",
    "expo-updates": "~58.0.18",
    "lucide-react-native": "^1.52.0",
    "nativewind": "^4.2.7",
    "pdfjs-dist": "^6.4.299",
    "react": "19.3.0",
    "react-native": "0.88.1",
    "react-native-css-interop": "0.2.7",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.30.1",
    "react-native-svg": "15.16.0",
    "react-native-web": "~0.21.4",
    "react-native-webview": "14.0.1",
    "react-native-worklets": "0.13.0",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^3.4.19",
    "tailwindcss-animate": "^1.0.7",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@babel/plugin-transform-react-jsx": "^7.25.9",
    "@types/jest": "29.5.14",
    "@types/node": "^20.19.43",
    "@types/react": "~19.3.0",
    "@types/react-dom": "~19.3.0",
    "agentation": "^3.0.2",
    "babel-preset-expo": "~58.0.23",
    "react-dom": "19.3.0",
    "typescript": "^5.7.0"
  },
  "expo": {
    "install": {
      "exclude": [
        "@sentry/react-native",
        "typescript",
        "@types/jest",
        "react-native-safe-area-context",
        "expo",
        "expo-constants",
        "expo-linking",
        "expo-router",
        "expo-sharing",
        "expo-splash-screen",
        "expo-updates"
      ]
    },
    "doctor": {
      "appConfigFieldsNotSyncedCheck": {
        "enabled": false
      }
    }
  }
}
