    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@types/jest": "29.5.14",
    "@types/node": "^20.19.43",
    "@types/react": "~19.2.4",
    "@types/react-dom": "~19.2.3",
    "agentation": "^3.0.2",
    "react-dom": "19.2.3",
    "typescript": "^6.0.3"
  },
  "expo": {
    "install": {
      "exclude": [
        "@sentry/react-native"
      ]
    }
  }
}
