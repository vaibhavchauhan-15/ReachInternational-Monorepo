# ReachInternational Mobile — Environment Variable Template
# Copy to `apps/mobile/.env` or `apps/mobile/.env.local` for local development.
# For EAS Build, configure public environment variables in `eas.json` or EAS Secrets.
#
# ==============================================================================
# CRITICAL SECURITY NOTICE FOR NATIVE MOBILE:
# All variables prefixed with `EXPO_PUBLIC_` are bundled directly into the client
# mobile binary (APK / AAB / IPA). They can be decompiled and inspected by users.
#
# NEVER put private server secrets (e.g. SUPABASE_SECRET_KEY, SENDGRID_API_KEY,
# TWILIO_AUTH_TOKEN, or database passwords) in this file or any mobile bundle!
# The mobile app communicates strictly via RLS-protected anonymous keys.
# ==============================================================================

# Active Environment Mode: development | preview | production
EXPO_PUBLIC_APP_ENV=development

# Mobile Shell Mode: native (standard React Native screens) | webview (embedded responsive web shell)
EXPO_PUBLIC_SHELL_MODE=native

# Deep-Link URL Scheme
EXPO_PUBLIC_SCHEME=reachinternational

# Supabase Public Anonymous API Endpoint & Publishable Anonymous Key (Protected by RLS)
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_publishable_key_here

# Web App Endpoint & Public Domain
EXPO_PUBLIC_APP_URL=https://dashboard-reachinternational.vercel.app
EXPO_PUBLIC_WEB_APP_URL=https://dashboard-reachinternational.vercel.app

# Sentry Error Reporting DSN (Client Safe)
EXPO_PUBLIC_SENTRY_DSN=https://your_sentry_dsn_here@o0.ingest.sentry.io/0

# Agentation Visual Feedback Tool (Web Desktop only)
EXPO_PUBLIC_ENABLE_AGENTATION=false
