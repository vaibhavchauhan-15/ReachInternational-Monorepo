# ServiceCentric Mobile — Multi-Environment Variable Template (Phase 32)
# Copy to `.env` or `.env.local` for local execution

# Active Environment Mode: development | staging | production
EXPO_PUBLIC_APP_ENV=development

# Supabase Public Anonymous API Endpoint & Key
EXPO_PUBLIC_SUPABASE_URL=https://reachinternational.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your_public_anon_key_here

# Deep-Link URL Scheme
EXPO_PUBLIC_SCHEME=reachservice
