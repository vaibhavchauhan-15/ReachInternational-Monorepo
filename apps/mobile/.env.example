# ReachInternational Mobile — Multi-Environment Variable Template
# Copy to `.env` or `.env.local` for local execution

# Active Environment Mode: development | staging | production
EXPO_PUBLIC_APP_ENV=development

# Supabase Public Anonymous API Endpoint & Key
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_publishable_key_here

# Deep-Link URL Scheme
EXPO_PUBLIC_SCHEME=reachinternational
