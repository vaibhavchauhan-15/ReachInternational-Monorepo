{
  "expo": {
    "name": "Reach Ops",
    "slug": "reachinternational-monorepo",
    "version": "1.2.0",
    "orientation": "default",
    "icon": "./assets/icon.png",
    "scheme": "reachinternational",
    "userInterfaceStyle": "automatic",
    "assetBundlePatterns": [
      "assets/**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.reachinternational.app"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "package": "com.reachinternational.app",
      "versionCode": 3,
      "allowBackup": false,
      "softwareKeyboardLayoutMode": "resize",
      "predictiveBackGestureEnabled": true,
      "permissions": [
        "INTERNET",
        "ACCESS_NETWORK_STATE",
        "POST_NOTIFICATIONS",
        "VIBRATE"
      ],
      "blockedPermissions": [
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.ACCESS_WIFI_STATE",
        "android.permission.USE_FINGERPRINT",
        "android.permission.USE_BIOMETRIC"
      ],
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "www.reachinternational.co.in"
            },
            {
              "scheme": "https",
              "host": "reachinternational.co.in"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ]
    },
    "web": {
      "bundler": "metro",
      "favicon": "./public/light-favicon-96x96.png"
    },
    "updates": {
      "url": "https://u.expo.dev/40432ac1-55a2-4bfa-985e-a51562398743",
      "enabled": false,
      "checkAutomatically": "NEVER"
    },
    "runtimeVersion": "1.2.0",
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash.png",
          "resizeMode": "contain",
          "backgroundColor": "#ffffff"
        }
      ],
      [
        "@sentry/react-native/expo",
        {
          "organization": "reachinternational",
          "project": "react-native",
          "disableAutoUpload": true
        }
      ]
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "40432ac1-55a2-4bfa-985e-a51562398743"
      }
    }
  }
}
