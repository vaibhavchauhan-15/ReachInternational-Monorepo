{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "reachinternational-monorepo",
  "main": ".open-next/worker.js",
  "compatibility_date": "2025-08-16",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "triggers": {
    "crons": [
      "0 2 * * *",
      "0 3 * * *",
      "0 0 * * *"
    ]
  },
  "vars": {
    "NODE_ENV": "production"
  },
  "observability": {
    "enabled": true
  }
}
