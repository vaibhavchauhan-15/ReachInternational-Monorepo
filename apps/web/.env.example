# Next.js Web App — Environment Variable Template
# Copy to `apps/web/.env.local` for local development

# ==============================================================================
# 1. PUBLIC / PUBLISHABLE KEYS (SAFE FOR BROWSER COMPONENTS)
# ==============================================================================
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key_here
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-DC126P3SM9

# ==============================================================================
# 2. SERVER-ONLY SECRETS (SERVER ACTIONS, DAL, API ROUTES ONLY)
# NEVER IMPORT OR ACCESS THESE IN CLIENT COMPONENTS ('use client')
# ==============================================================================
SUPABASE_SECRET_KEY=your_supabase_service_role_secret_key_here

# Cron Security Token
CRON_SECRET=your_random_cron_secret_here
