# Next.js Web App — Environment Variable Template
# Copy to `apps/web/.env.local` for local development
# In deployment (Vercel), configure these in Project Settings -> Environment Variables

# ==============================================================================
# 1. PUBLIC / PUBLISHABLE CONFIGURATION (Safe for browser client components)
# Only variables prefixed with NEXT_PUBLIC_ are bundled into client JavaScript.
# ==============================================================================
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key_here
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-DC126P3SM9
NEXT_PUBLIC_APP_VERSION=1.0.0
NEXT_PUBLIC_SENTRY_DSN=https://your_sentry_dsn_here@o0.ingest.sentry.io/0

# Feature Flags (Client-Safe)
NEXT_PUBLIC_ENABLE_AGENTATION=false
NEXT_PUBLIC_ENABLE_PULL_TO_REFRESH=true

# ==============================================================================
# 2. SERVER-ONLY SECRETS (Server Actions, DAL, Route Handlers ONLY)
# NEVER import or expose these in client components ('use client').
# Protected at build time by import "server-only" in lib/env/server.ts.
# ==============================================================================
SUPABASE_SECRET_KEY=your_supabase_service_role_secret_key_here
INTERNAL_AUTH_SECRET=your_32_byte_hex_internal_auth_secret_here

# Cron / Automation Security Token
CRON_SECRET=your_random_cron_secret_here

# Optional: Upstash Redis Rate Limiting (Server-Only)
UPSTASH_REDIS_REST_URL=https://your-upstash-redis.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_upstash_redis_token_here

# Optional: Server-Side Sentry DSN (falls back to NEXT_PUBLIC_SENTRY_DSN if unset)
SENTRY_DSN=https://your_sentry_dsn_here@o0.ingest.sentry.io/0
